generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                @id @default(autoincrement())
  email         String             @unique
  password_hash String
  role          String             @default("STUDENT")
  status        String             @default("ACTIVE")   // ACTIVE, LOCKED, DISABLED
  is_locked     Boolean            @default(false)
  created_at    DateTime           @default(now())
  enrollments   Enrollment[]
  tasks         Task[]
  studySessions StudySession[] 
  predictions   Prediction[]
  quizAttempts  QuizAttempt[]
  studyPlans    StudyPlan[]
  tutorSessions TutorSession[]
  flashcards    Flashcard[]
  learningGoals LearningGoal[]
  auditLogs     AuditLog[]
  notifications UserNotification[]
}

model LearningGoal {
  id          Int          @id @default(autoincrement())
  user_id     Int
  title       String       // "Chứng chỉ AWS Solution Architect", "Lập trình Fullstack Web", "IELTS 7.0"
  description String?      @db.Text
  target_date DateTime?
  status      String       @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED
  created_at  DateTime     @default(now())
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([user_id])
}

model Course {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  description String?      @db.Text
  difficulty  String       @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  credits     Int?         @default(3)          // Giữ trường tương thích cho dữ liệu cũ
  created_at  DateTime     @default(now())
  updated_at  DateTime     @default(now()) @updatedAt
  enrollments Enrollment[]
  topics      Topic[]
  flashcards  Flashcard[]
}

model Enrollment {
  id              Int              @id @default(autoincrement())
  user_id         Int
  course_id       Int
  goal_id         Int?
  target_goal     String           @default("Lập trình Fullstack Web")
  semester        String?          @default("Mục tiêu 2026")
  status          String           @default("ACTIVE")
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  goal            LearningGoal?    @relation(fields: [goal_id], references: [id], onDelete: SetNull)
  gradeComponents GradeComponent[]
  tasks           Task[]
  studySessions   StudySession[]

  @@unique([user_id, course_id, target_goal])
}

model GradeComponent {
  id            Int        @id @default(autoincrement())
  enrollment_id Int
  name          String
  weight        Float
  score         Float?
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [id])
}

model Task {
  id            Int        @id @default(autoincrement())
  user_id       Int
  enrollment_id Int
  title         String
  description   String?    @db.Text
  due_date      DateTime
  status        String     @default("TODO")
  created_at    DateTime   @default(now())
  completed_at  DateTime?
  user          User       @relation(fields: [user_id], references: [id])
  enrollment    Enrollment @relation(fields: [enrollment_id], references: [id])
}

model StudySession {
  id               Int         @id @default(autoincrement())
  user_id          Int
  enrollment_id    Int?        // Có thể gắn với một môn học cụ thể hoặc để null (học tự do)
  start_time       DateTime    @default(now())
  end_time         DateTime?
  duration_minutes Int?        // Thời lượng tính bằng phút
  status           String      @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  notes            String?     @db.Text
  created_at       DateTime    @default(now())
  user             User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollment       Enrollment? @relation(fields: [enrollment_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([enrollment_id])
}

model Prediction {
  id              Int              @id @default(autoincrement())
  user_id         Int
  risk_level      String
  model_version   String
  features_used   String?          @db.Text // Lưu lại snapshot data lúc dự đoán (JSON)
  created_at      DateTime         @default(now())
  user            User             @relation(fields: [user_id], references: [id])
  recommendations Recommendation[]
}

model Recommendation {
  id            Int        @id @default(autoincrement())
  prediction_id Int
  action_text   String
  reason        String     @db.Text
  priority      Int
  status        String     @default("PENDING") // PENDING, COMPLETED
  prediction    Prediction @relation(fields: [prediction_id], references: [id])
}

model Topic {
  id          Int            @id @default(autoincrement())
  course_id   Int
  title       String
  description String?        @db.Text
  order_index Int            @default(0)
  created_at  DateTime       @default(now())
  course      Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  materials   Material[]
  quizzes     Quiz[]
  sections    TopicSection[]

  @@index([course_id])
}

enum MaterialType {
  READING
  VIDEO
  DOCUMENT_URL
  CODE_SNIPPET
}

model Material {
  id           Int           @id @default(autoincrement())
  topic_id     Int
  section_id   Int?
  title        String
  type         MaterialType  @default(READING)
  content_type String        @default("MARKDOWN") // Giữ tương thích dữ liệu cũ
  content      String        @db.LongText
  file_url     String?       @db.Text
  reading_time Int?          @default(5) // Thời gian đọc ước tính (phút)
  order_index  Int           @default(0)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now()) @updatedAt
  topic        Topic         @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  section      TopicSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)

  @@index([topic_id])
  @@index([section_id])
}

model Quiz {
  id                 Int           @id @default(autoincrement())
  topic_id           Int
  title              String
  description        String?       @db.Text
  time_limit_minutes Int           @default(15)
  created_at         DateTime      @default(now())
  topic              Topic         @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  questions          Question[]
  attempts           QuizAttempt[]

  @@index([topic_id])
}

model Question {
  id                   Int          @id @default(autoincrement())
  quiz_id              Int
  question_text        String       @db.Text
  options              String       @db.Text // JSON String mảng các đáp án: ["A", "B", "C", "D"]
  correct_option_index Int          // Chỉ số đáp án đúng (0, 1, 2, 3)
  explanation          String?      @db.Text
  skill_tag            String       // Thẻ kỹ năng, VD: "khai_bao_con_tro", "them_xoa_nut"
  quiz                 Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  quizAnswers          QuizAnswer[]

  @@index([quiz_id])
}

model QuizAttempt {
  id                    Int          @id @default(autoincrement())
  user_id               Int
  quiz_id               Int
  score                 Float        // Thang điểm 10.0
  total_questions       Int
  correct_answers_count Int
  skill_breakdown       String       @db.Text // JSON lưu kết quả phân tích theo skill_tag
  created_at            DateTime     @default(now())
  user                  User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  quiz                  Quiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  answers               QuizAnswer[]

  @@index([user_id])
  @@index([quiz_id])
}

model QuizAnswer {
  id                    Int         @id @default(autoincrement())
  attempt_id            Int
  question_id           Int
  selected_option_index Int
  is_correct            Boolean
  attempt               QuizAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question              Question    @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([attempt_id])
}

model StudyPlan {
  id         Int             @id @default(autoincrement())
  user_id    Int
  status     String          @default("ACTIVE") // ACTIVE, COMPLETED
  created_at DateTime        @default(now())
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      StudyPlanItem[]

  @@index([user_id])
}

model StudyPlanItem {
  id           Int       @id @default(autoincrement())
  plan_id      Int
  title        String
  description  String?   @db.Text
  action_type  String    // REVIEW_THEORY, PRACTICE_QUIZ, ADVANCED_TOPIC
  reference_id Int?      // ID của Material hoặc Quiz tương ứng
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, DONE
  priority     Int       @default(2) // 1: HIGH, 2: MEDIUM, 3: LOW
  created_at   DateTime  @default(now())
  plan         StudyPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([plan_id])
}

model TutorSession {
  id         Int            @id @default(autoincrement())
  user_id    Int
  topic      String?        // Chủ đề cuộc trò chuyện (tự động sinh)
  created_at DateTime       @default(now())
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages   TutorMessage[]

  @@index([user_id])
}

model TutorMessage {
  id         Int          @id @default(autoincrement())
  session_id Int
  sender     String       // "USER" hoặc "AI"
  content    String       @db.Text
  created_at DateTime     @default(now())
  session    TutorSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
}

model Flashcard {
  id          Int      @id @default(autoincrement())
  user_id     Int
  course_id   Int?
  front       String   @db.Text
  back        String   @db.Text
  repetition  Int      @default(0)
  interval    Int      @default(1)    // Khoảng cách ôn tập tính theo ngày
  ease_factor Float    @default(2.5)  // Hệ số dễ (tối thiểu 1.3)
  next_review DateTime @default(now()) // Mốc thời gian đến hạn ôn tập
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [course_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([next_review])
}

model TopicSection {
  id          Int        @id @default(autoincrement())
  topic_id    Int
  title       String
  description String?    @db.Text
  order_index Int        @default(0)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @default(now()) @updatedAt
  topic       Topic      @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  materials   Material[]

  @@index([topic_id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  user_email  String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, LOCK, UNLOCK
  entity      String   // User, Course, Topic, Material, etc.
  entity_id   String?
  description String   @db.Text
  ip_address  String?
  user_agent  String?  @db.Text
  old_data    String?  @db.LongText // JSON snapshot before change
  new_data    String?  @db.LongText // JSON snapshot after change
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([entity])
  @@index([created_at])
}

model AILog {
  id             Int      @id @default(autoincrement())
  user_id        Int?
  function_type  String   // CHAT_TUTOR, GENERATE_QUIZ, PREDICT_RISK, GENERATE_PLAN
  request_data   String?  @db.Text // JSON
  response_data  String?  @db.Text // JSON (truncated)
  latency_ms     Int?     // Response time in milliseconds
  tokens_used    Int?
  status         String   @default("SUCCESS") // SUCCESS, ERROR, TIMEOUT
  error_message  String?  @db.Text
  created_at     DateTime @default(now())

  @@index([function_type])
  @@index([created_at])
  @@index([status])
}

model AIConfig {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  value           String   @db.Text
  description     String?
  updated_by      String?
  updated_at      DateTime @default(now()) @updatedAt
}

model SystemNotification {
  id           Int                @id @default(autoincrement())
  title        String
  content      String             @db.Text
  type         String             @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  target       String             @default("ALL")  // ALL, ADMIN, USER, or specific user_id
  is_published Boolean            @default(false)
  published_at DateTime?
  expires_at   DateTime?
  created_by   String?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @default(now()) @updatedAt
  reads        UserNotification[]
}

model UserNotification {
  id              Int                @id @default(autoincrement())
  user_id         Int
  notification_id Int
  is_read         Boolean            @default(false)
  read_at         DateTime?
  user            User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notification    SystemNotification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@unique([user_id, notification_id])
  @@index([user_id])
}

