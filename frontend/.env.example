# Frontend Environment Variables Example
# Khi test tren Android Emulator, de mac dinh se tu dung 10.0.2.2:3000/api
# Khi test tren dien thoai that qua Expo Go, nhap IP LAN may tinh, vi du:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

DATABASE_URL="mysql://root:password@localhost:3306/smartstudy_db"
JWT_SECRET="your_super_secret_jwt_key_here"
AI_SERVICE_URL="http://127.0.0.1:8000"
GEMINI_API_KEY="your_llm_api_key_here"